<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_reservation_tree" model="ir.ui.view">
    <field name="name">estate.reservation.list</field>
    <field name="model">estate.reservation</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="unit_id"/>
        <field name="partner_id"/>
        <field name="date"/>
        <field name="deposit_amount"/>
        <field name="status"/>
      </list>
    </field>
  </record>

  <record id="view_reservation_form" model="ir.ui.view">
    <field name="name">estate.reservation.form</field>
    <field name="model">estate.reservation</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name" readonly="1"/>
            <field name="unit_id"/>
            <field name="partner_id"/>
            <field name="date"/>
            <field name="deposit_amount"/>
            <field name="status"/>
          </group>
          <group>
            <field name="note"/>
          </group>
          <footer>
            <button name="action_confirm" type="object" string="Confirm" class="oe_highlight"/>
            <button name="action_cancel" type="object" string="Cancel"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_estate_reservation" model="ir.actions.act_window">
    <field name="name">Reservations</field>
    <field name="res_model">estate.reservation</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
