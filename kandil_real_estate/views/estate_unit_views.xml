<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Units list view (Odoo 18 uses <list>) -->
  <record id="view_unit_list" model="ir.ui.view">
    <field name="name">estate.unit.list</field>
    <field name="model">estate.unit</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="building_id"/>
        <field name="unit_type"/>
        <field name="area_sqm"/>
        <!-- price should be Monetary in the model and displayed with widget monetary -->
        <field name="price" widget="monetary"/>
        <field name="status"/>
      </list>
    </field>
  </record>

  <!-- Form view -->
  <record id="view_unit_form" model="ir.ui.view">
    <field name="name">estate.unit.form</field>
    <field name="model">estate.unit</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="building_id"/>
            <field name="unit_type"/>
            <field name="area_sqm"/>
            <field name="bedrooms"/>
            <field name="floor"/>
          </group>
          <group>
            <!-- price must be Monetary and currency_id must exist on the model -->
            <field name="price" widget="monetary"/>
            <field name="currency_id"/>
            <field name="status"/>
            <field name="assigned_partner_id"/>
          </group>
          <notebook>
            <page string="Features">
              <field name="features"/>
            </page>
            <page string="Reservations">
              <field name="reservation_count" readonly="1"/>
              <field name="reservation_ids" context="{'default_unit_id': id}"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_estate_unit" model="ir.actions.act_window">
    <field name="name">Units</field>
    <field name="res_model">estate.unit</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
