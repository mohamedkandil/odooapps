<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List view (contracts) -->
    <record id="view_contract_list" model="ir.ui.view">
        <field name="name">estate.contract.list</field>
        <field name="model">estate.contract</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="unit_id"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form view (contract) -->
    <record id="view_contract_form" model="ir.ui.view">
        <field name="name">estate.contract.form</field>
        <field name="model">estate.contract</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="unit_id"/>
                        <field name="contract_type"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>

                    <group>
                        <field name="currency_id"/>
                        <field name="total_amount"/>
                        <field name="down_payment"/>
                        <field name="state"/>
                        <field name="salesperson_id"/>
                    </group>

                    <notebook>
                        <page string="Installments">
                            <field name="installment_ids" nolabel="1">
                                <list string="Installments">
                                    <field name="amount"/>
                                    <field name="due_date"/>
                                    <field name="paid"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_estate_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">estate.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>