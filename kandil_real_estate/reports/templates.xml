<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="estate.contract_report">
    <t t-call="web.html_container">
      <div class="page">
        <h2>Contract: <span t-field="doc.name"/></h2>
        <p>Customer: <span t-field="doc.partner_id.name"/></p>
        <p>Unit: <span t-field="doc.unit_id.name"/></p>
        <p>Total Amount: <span t-field="doc.total_amount"/></p>
        <table class="table table-condensed">
          <thead>
            <tr><th>Due Date</th><th>Amount</th><th>Paid</th></tr>
          </thead>
          <tbody>
            <t t-foreach="doc.installment_ids" t-as="i">
              <tr>
                <td><t t-esc="i.due_date"/></td>
                <td><t t-esc="i.amount"/></td>
                <td><t t-esc="i.paid and 'Yes' or 'No'"/></td>
              </tr>
            </t>
          </tbody>
        </table>
      </div>
    </t>
  </template>
</odoo>
