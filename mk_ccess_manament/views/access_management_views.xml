<odoo>
    <record id="view_access_management_tree" model="ir.ui.view">
        <field name="name">access.management.tree</field>
        <field name="model">access.management</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="company_ids" widget="many2many_tags"/>
                <field name="readonly_user"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_access_management_form" model="ir.ui.view">
        <field name="name">access.management.form</field>
        <field name="model">access.management</field>
        <field name="arch" type="xml">
            <form string="Access Management">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Purchase Access"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="readonly_user"/>
                            <field name="disable_developer_mode"/>
                            <field name="group_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hide Menu" name="hide_menu">
                            <field name="menu_ids" nolabel="1">
                                <tree>
                                    <field name="complete_name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Model Access" name="model_access">
                            <field name="model_access_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="model_id"/>
                                    <field name="hide_create"/>
                                    <field name="hide_edit"/>
                                    <field name="hide_delete"/>
                                    <field name="hide_duplicate"/>
                                    <field name="hide_archive"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Field Access" name="field_access">
                            <field name="field_access_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="model_id"/>
                                    <field name="field_id" domain="[('model_id', '=', model_id)]"/>
                                    <field name="readonly"/>
                                    <field name="invisible"/>
                                    <field name="required"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Domain Access" name="domain_access">
                            <field name="domain_access_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="model_id"/>
                                    <field name="domain_force"/>
                                    <field name="perm_read"/>
                                    <field name="perm_write"/>
                                    <field name="perm_create"/>
                                    <field name="perm_unlink"/>
                                    <field name="rule_id" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Button/Tab Access" name="button_access">
                            <field name="button_access_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="model_id"/>
                                    <field name="type"/>
                                    <field name="technical_name"/>
                                    <field name="string"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Hide Filter/Group By" name="filter_access">
                            <field name="filter_access_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="model_id"/>
                                    <field name="filter_name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Chatter" name="chatter">
                            <group string="Chatter">
                                <field name="hide_chatter"/>
                                <field name="hide_send_message"/>
                                <field name="hide_log_notes"/>
                                <field name="hide_schedule_activity"/>
                            </group>
                        </page>
                        <page string="Global" name="global">
                            <group string="Import &amp; Export">
                                <field name="hide_import"/>
                                <field name="hide_export"/>
                                <field name="hide_spreadsheet"/>
                                <field name="hide_add_property"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Apply one rule to selected users, or leave companies empty to apply it in all companies.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_access_management_search" model="ir.ui.view">
        <field name="name">access.management.search</field>
        <field name="model">access.management</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_access_management" model="ir.actions.act_window">
        <field name="name">Access Management</field>
        <field name="res_model">access.management</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_access_management_search"/>
    </record>
</odoo>
