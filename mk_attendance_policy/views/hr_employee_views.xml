<odoo>
    <record id="view_hr_employee_form_inherit_attendance_policy" model="ir.ui.view">
        <field name="name">hr.employee.form.attendance.policy</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']" position="inside">
                <field name="attendance_policy_id"/>
            </xpath>
        </field>
    </record>
</odoo>
