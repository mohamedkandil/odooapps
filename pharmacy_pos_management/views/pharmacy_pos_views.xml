<odoo>
    <record id="view_pharmacy_pos_tree" model="ir.ui.view">
        <field name="name">pharmacy.pos.tree</field>
        <field name="model">pharmacy.pos</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="cashbox_id"/>
                <field name="cashier_id"/>
                <field name="session_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_pharmacy_pos_form" model="ir.ui.view">
        <field name="name">pharmacy.pos.form</field>
        <field name="model">pharmacy.pos</field>
        <field name="arch" type="xml">
            <form string="Pharmacy POS Session">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="branch_id"/>
                        <field name="cashbox_id"/>
                        <field name="cashier_id"/>
                        <field name="session_date"/>
                        <field name="state"/>
                    </group>
                    <notebook>
                        <page string="Orders">
                            <field name="order_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="customer_id"/>
                                    <field name="prescription_id"/>
                                    <field name="total"/>
                                    <field name="amount_paid"/>
                                    <field name="amount_due"/>
                                    <field name="state"/>
                                    <field name="is_held"/>
                                    <field name="date_order"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pharmacy_pos" model="ir.actions.act_window">
        <field name="name">POS Sessions</field>
        <field name="res_model">pharmacy.pos</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_pharmacy_pos_order_tree" model="ir.ui.view">
        <field name="name">pharmacy.pos.order.tree</field>
        <field name="model">pharmacy.pos.order</field>
        <field name="arch" type="xml">
            <tree decoration-muted="is_held" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="pos_id"/>
                <field name="branch_id"/>
                <field name="customer_id"/>
                <field name="total"/>
                <field name="amount_paid"/>
                <field name="amount_due"/>
                <field name="state"/>
                <field name="is_held"/>
                <field name="date_order"/>
            </tree>
        </field>
    </record>
    <record id="view_pharmacy_pos_order_form" model="ir.ui.view">
        <field name="name">pharmacy.pos.order.form</field>
        <field name="model">pharmacy.pos.order</field>
        <field name="arch" type="xml">
            <form string="Pharmacy POS Order">
                <header>
                    <button name="action_hold" type="object" string="Hold" invisible="state != 'draft'"/>
                    <button name="action_pay" type="object" string="Mark Paid" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_refund" type="object" string="Refund" invisible="state != 'paid'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="pos_id"/>
                            <field name="branch_id"/>
                            <field name="customer_id"/>
                            <field name="prescription_id"/>
                            <field name="date_order"/>
                        </group>
                        <group>
                            <field name="total"/>
                            <field name="amount_paid"/>
                            <field name="amount_due"/>
                            <field name="is_held"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="batch_id"/>
                                    <field name="expiry_date"/>
                                    <field name="available_qty"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payments">
                            <field name="payment_ids">
                                <tree editable="bottom">
                                    <field name="payment_method"/>
                                    <field name="amount"/>
                                    <field name="payment_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pharmacy_pos_order" model="ir.actions.act_window">
        <field name="name">POS Orders</field>
        <field name="res_model">pharmacy.pos.order</field>
        <field name="view_mode">tree,form,pivot,graph</field>
    </record>

    <menuitem id="menu_pharmacy_pos_action" name="POS Sessions" parent="menu_pharmacy_pos" action="action_pharmacy_pos" sequence="10"/>
    <menuitem id="menu_pharmacy_pos_order_action" name="POS Orders" parent="menu_pharmacy_pos" action="action_pharmacy_pos_order" sequence="20"/>
</odoo>
