<odoo>
    <record id="view_pharmacy_inventory_tree" model="ir.ui.view">
        <field name="name">pharmacy.inventory.tree</field>
        <field name="model">pharmacy.inventory</field>
        <field name="arch" type="xml">
            <tree decoration-warning="stock_state == 'low'" decoration-danger="stock_state == 'out'">
                <field name="product_id"/>
                <field name="branch_id"/>
                <field name="batch_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="lot_number"/>
                <field name="expiry_date"/>
                <field name="min_stock"/>
                <field name="reorder_qty"/>
                <field name="stock_state"/>
                <field name="last_inventory_date"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_pharmacy_inventory_form" model="ir.ui.view">
        <field name="name">pharmacy.inventory.form</field>
        <field name="model">pharmacy.inventory</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Inventory">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="branch_id"/>
                        <field name="company_id"/>
                        <field name="batch_id"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                        <field name="lot_number"/>
                        <field name="expiry_date"/>
                        <field name="min_stock"/>
                        <field name="reorder_qty"/>
                        <field name="stock_state"/>
                        <field name="last_inventory_date"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pharmacy_inventory" model="ir.actions.act_window">
        <field name="name">Inventory</field>
        <field name="res_model">pharmacy.inventory</field>
        <field name="view_mode">tree,form,pivot,graph</field>
    </record>

    <record id="view_pharmacy_inventory_adjustment_tree" model="ir.ui.view">
        <field name="name">pharmacy.inventory.adjustment.tree</field>
        <field name="model">pharmacy.inventory.adjustment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="product_id"/>
                <field name="batch_id"/>
                <field name="quantity"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_pharmacy_inventory_adjustment_form" model="ir.ui.view">
        <field name="name">pharmacy.inventory.adjustment.form</field>
        <field name="model">pharmacy.inventory.adjustment</field>
        <field name="arch" type="xml">
            <form string="Inventory Adjustment">
                <header>
                    <button name="action_done" type="object" string="Apply" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="branch_id"/>
                        <field name="product_id"/>
                        <field name="batch_id"/>
                        <field name="quantity"/>
                        <field name="reason"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pharmacy_inventory_adjustment" model="ir.actions.act_window">
        <field name="name">Inventory Adjustments</field>
        <field name="res_model">pharmacy.inventory.adjustment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_pharmacy_stock_transfer_tree" model="ir.ui.view">
        <field name="name">pharmacy.stock.transfer.tree</field>
        <field name="model">pharmacy.stock.transfer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="source_branch_id"/>
                <field name="dest_branch_id"/>
                <field name="product_id"/>
                <field name="batch_id"/>
                <field name="quantity"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_pharmacy_stock_transfer_form" model="ir.ui.view">
        <field name="name">pharmacy.stock.transfer.form</field>
        <field name="model">pharmacy.stock.transfer</field>
        <field name="arch" type="xml">
            <form string="Branch Stock Transfer">
                <header>
                    <button name="action_done" type="object" string="Validate" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="source_branch_id"/>
                        <field name="dest_branch_id"/>
                        <field name="product_id"/>
                        <field name="batch_id"/>
                        <field name="quantity"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pharmacy_stock_transfer" model="ir.actions.act_window">
        <field name="name">Branch Transfers</field>
        <field name="res_model">pharmacy.stock.transfer</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_pharmacy_inventory_action" name="Stock Availability" parent="menu_pharmacy_inventory" action="action_pharmacy_inventory" sequence="10"/>
    <menuitem id="menu_pharmacy_inventory_adjustment_action" name="Adjustments" parent="menu_pharmacy_inventory" action="action_pharmacy_inventory_adjustment" sequence="30"/>
    <menuitem id="menu_pharmacy_stock_transfer_action" name="Branch Transfers" parent="menu_pharmacy_inventory" action="action_pharmacy_stock_transfer" sequence="40"/>
</odoo>
