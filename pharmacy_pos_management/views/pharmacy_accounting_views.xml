<odoo>
    <record id="view_pharmacy_accounting_tree" model="ir.ui.view">
        <field name="name">pharmacy.accounting.tree</field>
        <field name="model">pharmacy.accounting</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="journal_id"/>
                <field name="move_id"/>
                <field name="analytic_account_id"/>
                <field name="cost_center_id"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_pharmacy_accounting_form" model="ir.ui.view">
        <field name="name">pharmacy.accounting.form</field>
        <field name="model">pharmacy.accounting</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Accounting">
                <header>
                    <button name="action_post" type="object" string="Post" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="branch_id"/>
                        <field name="company_id"/>
                        <field name="journal_id"/>
                        <field name="move_id"/>
                        <field name="analytic_account_id"/>
                        <field name="cost_center_id"/>
                        <field name="amount"/>
                        <field name="date"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pharmacy_accounting" model="ir.actions.act_window">
        <field name="name">Accounting</field>
        <field name="res_model">pharmacy.accounting</field>
        <field name="view_mode">tree,form,pivot,graph</field>
    </record>
    <menuitem id="menu_pharmacy_accounting_action" name="Accounting" parent="menu_pharmacy_reports" action="action_pharmacy_accounting" sequence="90"/>
</odoo>
