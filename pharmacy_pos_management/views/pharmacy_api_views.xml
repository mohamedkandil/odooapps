<odoo>
    <record id="view_pharmacy_integration_endpoint_tree" model="ir.ui.view">
        <field name="name">pharmacy.integration.endpoint.tree</field>
        <field name="model">pharmacy.integration.endpoint</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="integration_type"/>
                <field name="base_url"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_pharmacy_integration_endpoint_form" model="ir.ui.view">
        <field name="name">pharmacy.integration.endpoint.form</field>
        <field name="model">pharmacy.integration.endpoint</field>
        <field name="arch" type="xml">
            <form string="Integration Endpoint">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="integration_type"/>
                        <field name="base_url"/>
                        <field name="api_key" password="True"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pharmacy_integration_endpoint" model="ir.actions.act_window">
        <field name="name">Integration Endpoints</field>
        <field name="res_model">pharmacy.integration.endpoint</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_pharmacy_api_action" name="API Endpoints" parent="menu_pharmacy_integrations" action="action_pharmacy_integration_endpoint" sequence="10"/>
</odoo>
