<odoo>
    <data noupdate="1">
        <record id="group_pharmacy_admin" model="res.groups">
            <field name="name">Pharmacy Administrator</field>
            <field name="category_id" ref="base.module_category_sales_management"/>
        </record>
        <record id="group_pharmacy_pharmacist" model="res.groups">
            <field name="name">Pharmacist</field>
            <field name="category_id" ref="base.module_category_sales_management"/>
        </record>
        <record id="group_pharmacy_cashier" model="res.groups">
            <field name="name">Cashier</field>
            <field name="category_id" ref="base.module_category_sales_management"/>
        </record>
        <record id="group_pharmacy_storekeeper" model="res.groups">
            <field name="name">Storekeeper</field>
            <field name="category_id" ref="base.module_category_sales_management"/>
        </record>
        <record id="group_pharmacy_accountant" model="res.groups">
            <field name="name">Accountant</field>
            <field name="category_id" ref="base.module_category_sales_management"/>
        </record>
    </data>
    <data noupdate="1">
        <record id="rule_pharmacy_branch_admin_company" model="ir.rule">
            <field name="name">Pharmacy branches by company</field>
            <field name="model_id" ref="model_pharmacy_branch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_admin'))]"/>
        </record>
        <record id="rule_pharmacy_inventory_user_branch" model="ir.rule">
            <field name="name">Pharmacy inventory by allowed branches</field>
            <field name="model_id" ref="model_pharmacy_inventory"/>
            <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'in', user.allowed_pharmacy_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_pharmacist')), (4, ref('group_pharmacy_cashier')), (4, ref('group_pharmacy_storekeeper'))]"/>
        </record>
        <record id="rule_pharmacy_pos_order_user_branch" model="ir.rule">
            <field name="name">Pharmacy POS orders by allowed branches</field>
            <field name="model_id" ref="model_pharmacy_pos_order"/>
            <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'in', user.allowed_pharmacy_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_pharmacist')), (4, ref('group_pharmacy_cashier'))]"/>
        </record>
    </data>
</odoo>
